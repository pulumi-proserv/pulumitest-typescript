{
  "name": "pulumitest",
  "version": "0.1.1",
  "description": "TypeScript testing utilities for Pulumi programs",
  "license": "Apache-2.0",
  "author": {
    "name": "Jonathan Davenport",
    "email": "jdavenport@pulumi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulumi-proserv/pulumitest-typescript.git"
  },
  "keywords": [
    "pulumi",
    "testing",
    "automation-api",
    "infrastructure"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@pulumi/pulumi": "^3.97.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
